#cards {
  & {
    background: white;
    padding: 18px;
    border-radius: 10px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
  }

  h3 {
    margin: 0;
    font-size: 14px;
    color: #64748b;
  }

  .value {
    font-size: 28px;
    font-weight: bold;
  }

  .success {
    color: #16a34a;
  }
}

#actionCards {
 

  & {
    background: white;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
  }

  h3 {
    margin-top: 0;
  }

  button {
    margin-top: 8px;
    padding: 8px 14px;
    border: none;
    border-radius: 6px;
    background: #4f46e5;
    color: white;
    cursor: pointer;
  }
}