 {
    "exclude": [
        "node_modules",
        "<?= outDir ?>",
    ],
    "include": [
        "<?= srcDir ?>"
    ],
    "compileOnSave": true,
    "compilerOptions": { 
        "module": "ESNext",
        "moduleResolution": "node",
        "target": "ESNext",
        "strict": true,
        "baseUrl": ".",
        "outDir": "./<?= outDir ?>",
        "rootDir": "./<?= srcDir ?>",
        "declaration": true,
        "sourceMap": true,
        "allowJs": true,
        "strictNullChecks": false,
        "esModuleInterop": true,
        "checkJs": false,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "noEmit": false,
        "skipLibCheck": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "removeComments": false,
        "noImplicitAny": false,
        "inlineSources": true,
        "paths": {
            "uc-runtime/*": [
                "./node_modules/uc-runtime/dist/*"
            ]
        }
    },
}