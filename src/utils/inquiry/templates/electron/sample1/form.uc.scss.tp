& {
  font-family: system-ui, sans-serif;
  background: #f6f8fb;
  color: #1f2933;
}

.dashboard {
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

/* HERO */

.hero {
  background: linear-gradient(135deg, #4f46e5, #6366f1);
  color: white;
  padding: 28px;
  border-radius: 12px;
}

.hero h1 {
  margin: 0 0 8px;
}

.primary-btn {
  margin-top: 12px;
  padding: 10px 16px;
  border: none;
  border-radius: 8px;
  background: white;
  color: #4f46e5;
  font-weight: 600;
  cursor: pointer;
}

/* STATS */

.stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 16px;
}

.card {
  background: white;
  padding: 18px;
  border-radius: 10px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.05);
}

.card h3 {
  margin: 0;
  font-size: 14px;
  color: #64748b;
}

.value {
  font-size: 28px;
  font-weight: bold;
}

.success {
  color: #16a34a;
}

/* ACTIONS */

.actions {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 16px;
}

.action-card {
  background: white;
  padding: 20px;
  border-radius: 10px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.05);
}

.action-card h3 {
  margin-top: 0;
}

.action-card button {
  margin-top: 8px;
  padding: 8px 14px;
  border: none;
  border-radius: 6px;
  background: #4f46e5;
  color: white;
  cursor: pointer;
}