<?php if(useElectron){ ?>
import { UserResource, ResourceStorage,UpdateResourcePath, Assembly, AssemblyManager,IpcMainHelper } from "<?= importPath ?>";
<?php }else{ ?>
import { UserResource, ResourceStorage,UpdateResourcePath, Assembly, AssemblyManager } from "<?= importPath ?>";
<?php } ?> 

declare module "<?= declareClassPath ?>" {
   export interface ResourceNamedRegistry{
      <?php
      const onlyAlias = resources.filter(s => s.name && s.name != "");
         for (const res of onlyAlias) { ?>
            <?= res.name ?> : <?= res.source ?>,
    <?php  } ?>
   }

   export interface TPPackage {
        <?php  for (const [pkg,vers] of Object.entries(PACKAGE_LIST)) { ?>
            "<?= pkg ?>": "", <?php 
        } ?>
   }

   
   export interface AssemblyRegistry{
        <?= mainProject.name ?> : Assembly
   }
   export interface ResourceKeyRegistry {
        <?php  for (const res of resources) { ?>
            <?= res.guid ?>: <?= res.source ?>,
        <?php } ?>
   }
}
const Resources:UserResource[] = [
<?php  for (const res of resources) { ?>
    {   guid: <?= res.guid ?>, <?php 
        if(res.isGlobalCss === true){ ?> isGlobalCss : true, <?php } 
        if(res.name && res.name!=''){ ?> name : <?= res.name ?>, <?php } 
        
        ?>  project: "<?= res.project ?>",  source: <?= res.source ?>,   type: "<?= res.type ?>",  encrypt:<?= res.encrypt ?>   }, <?php } ?>
];
ResourceStorage.bulkRegister(Resources);

export async function loadForNodeOnly(prePathForSubProjects: string = "") {

    AssemblyManager.Register(UpdateResourcePath({
         name: <?= mainProject.name ?>,
         ProjectGUID: "<?= mainProject.ProjectGUID ?>",
         ProjectCSS: <?= mainProject.ProjectCSS ?>,
         ProjectUcConfig: <?= mainProject.ProjectUcConfig ?>,
         ResourceStorageDir: <?= mainProject.ResourceStorageDir ?>,
    }, prePathForSubProjects));

    ResourceStorage.RuntimeProps['importmap'] = ResourceStorage.RuntimeProps['importmap'] ?? ResourceStorage.getContent("<?= mainProject.importMapGuid ?>");
    <?php  if(mainProject.mainHtmlGuid!=undefined){ ?>
    ResourceStorage.RuntimeProps['htmlcontent'] = ResourceStorage.RuntimeProps['htmlcontent'] ?? ResourceStorage.getContent("<?= mainProject.mainHtmlGuid ?>");
    <?php  } ?>

    <?php 
    for (const res of projectList) {
        if (res.importResource == true) { ?>
    (await import(<?= res.resourceRelativePath ?>)).loadForNodeOnly('node_modules/<?= res.project.projectName ?>');<?php    
        }    
    } ?>


    <?php 
    for (const res of ipcFileList) {
    ?>
    try { (await import("<?= res ?>")).default(); } catch(ex){ console.log(ex); } <?php           
    } ?>
    <?php if(useElectron){ ?>
    await IpcMainHelper.init();
    <?php } ?>
}
// console.log(fs.readFileSync(path.resolve('node_modules',<?= mainProject.name ?>, 'package.json'), 'binary'));

<?php if(useElectron){ ?> 
    <?php if(baseHtmlGuid){ ?>
export async function loadForElectron(win: Electron.BrowserWindow) {
    await loadForNodeOnly("");
    IpcMainHelper.loadContent(ResourceStorage.getContent("<?= baseHtmlGuid ?>"), win,   <?= baseHtmlLoadUrlOptions ?>);
}       
    <?php } ?>
<?php } ?>