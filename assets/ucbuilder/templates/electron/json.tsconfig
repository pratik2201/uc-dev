{
    "exclude": [
        "node_modules",
        "out",
    ],
    "include": [
        "src/**/*.ts"
    ],
    "compileOnSave": true,
    "compilerOptions": { 
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ESNext",
        "strict": true,
        "baseUrl": "./src",
        "outDir": "./out",
        "rootDir": "./src"
    }
}